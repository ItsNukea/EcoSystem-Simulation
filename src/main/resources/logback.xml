<configuration>
    <conversionRule conversionWord="levelColor" converterClass="es.sim.logging.LevelColorConverter" />
    <conversionRule conversionWord="msgColor" converterClass="es.sim.logging.LevelColorMessageConverter" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%blue([%d{HH:mm:ss}]) %levelColor([%thread/%level]) %cyan(\(%logger{36}\)) %msgColor(%msg) %n</pattern>
        </encoder>
    </appender>

    <appender name="LATEST" class="ch.qos.logback.core.FileAppender">
        <file>run/logs/latest.log</file>
        <append>false</append>
        <encoder>
            <pattern>[%d{HH:mm:ss}] [%thread/%level] \(%logger{36}\) %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="SESSION" class="ch.qos.logback.core.FileAppender">
        <file>run/logs/${session.timestamp}.log</file>
        <append>false</append>
        <encoder>
            <pattern>[%d{HH:mm:ss}] [%thread/%level] \(%logger{36}\) %msg%n</pattern>
        </encoder>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LATEST" />
        <appender-ref ref="SESSION" />
    </root>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />
</configuration>